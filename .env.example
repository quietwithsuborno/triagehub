# AI triage. Off by default. To turn it on: set AI_TRIAGE_ENABLED=True and
# put your own key in AI_API_KEY (never commit a real key). Any provider with
# an OpenAI-compatible API works; change the URL, key and model only.
AI_TRIAGE_ENABLED=False
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_SECONDS=10